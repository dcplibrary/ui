{
    "name": "dcplibrary/ui",
    "description": "DCPL shared UI design system — Blade components, Tailwind config, and CSS for the Daviess County Public Library app suite.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Daviess County Public Library",
            "email": "webmaster@dcplibrary.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Dcpl\\Ui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcpl\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
